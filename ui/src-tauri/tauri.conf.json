{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LOQ Monitor",
  "version": "0.5.1",
  "identifier": "local.loqmonitor.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node dev-server.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LOQ Monitor",
        "width": 1040,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ws://127.0.0.1:47821 http://127.0.0.1:47821"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "../../SensorService/publish/": "service/",
      "../../scripts/install-service.ps1": "service/install-service.ps1",
      "../../scripts/uninstall-service.ps1": "service/uninstall-service.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5Q0RFNzk5OUQ0NEE3MzYKUldRMnAwU2RtZWZOR2FkVUI0Sk9PTTFzekVPenhOMmZudDlFY3grMFljcDdUSWhrd00wYUJYcUYK",
      "endpoints": [
        "https://github.com/cahyata/loq-monitor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}